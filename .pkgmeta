package-as: JustAC

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
    - .git
    - .github
    - .gitignore
    - AGENTS.md
    - .luarc.json
    - .luacheckrc
    - .pkgmeta
    - README.md
    - CHANGELOG.md
    - UNRELEASED.md
    - Documentation
    - "*.code-workspace"
    - build.ps1
    - release.ps1
    - tools

# Library provenance. We VENDOR (commit) every library rather than fetch at build time,
# so a git clone is self-contained and a release is reproducible; the failures that
# "installing Ace3 separately" used to cure were partial installs, and a build-time
# fetch would reintroduce that shape. These are the canonical sources each embedded
# copy was pulled from (last full refresh 2026-08-18). To refresh: pull each source,
# replace the Libs/<name> tree wholesale (never patch single files), keep only .lua/.xml,
# then run tools/check.ps1 and the Lib checks in tools/ before committing.
#
#   Ace3 (AceAddon, AceConfig, AceConsole, AceDB, AceDBOptions, AceEvent, AceGUI,
#   AceLocale, AceTimer) + its embedded CallbackHandler-1.0 and LibStub:
#       https://github.com/WoWUIDev/Ace3            (also repos.wowace.com/wow/ace3/trunk)
#   LibSharedMedia-3.0:
#       https://repos.wowace.com/wow/libsharedmedia-3-0/trunk
#   AceGUI-3.0-SharedMediaWidgets:
#       https://repos.curseforge.com/wow/ace-gui-3-0-shared-media-widgets/trunk
#   LibDBIcon-1.0:
#       https://repos.wowace.com/wow/libdbicon-1-0/trunk
#   LibDataBroker-1.1 (frozen since 2008):
#       https://github.com/tekkub/libdatabroker-1-1
#
# The externals form of the same list, should build-time fetching ever be preferred:
# externals:
#     Libs/LibStub:
#         url: https://repos.wowace.com/wow/libstub/trunk
#     Libs/CallbackHandler-1.0:
#         url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
#     Libs/AceAddon-3.0:
#         url: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
#     Libs/AceDB-3.0:
#         url: https://repos.wowace.com/wow/ace3/trunk/AceDB-3.0
#     Libs/AceEvent-3.0:
#         url: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0
#     Libs/AceTimer-3.0:
#         url: https://repos.wowace.com/wow/ace3/trunk/AceTimer-3.0
#     Libs/AceConsole-3.0:
#         url: https://repos.wowace.com/wow/ace3/trunk/AceConsole-3.0
#     Libs/AceConfig-3.0:
#         url: https://repos.wowace.com/wow/ace3/trunk/AceConfig-3.0
#     Libs/AceGUI-3.0:
#         url: https://repos.wowace.com/wow/ace3/trunk/AceGUI-3.0
#     Libs/AceDBOptions-3.0:
#         url: https://repos.wowace.com/wow/ace3/trunk/AceDBOptions-3.0
#     Libs/AceLocale-3.0:
#         url: https://repos.wowace.com/wow/ace3/trunk/AceLocale-3.0
#     Libs/LibSharedMedia-3.0:
#         url: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
#     Libs/AceGUI-3.0-SharedMediaWidgets:
#         url: https://repos.curseforge.com/wow/ace-gui-3-0-shared-media-widgets/trunk
#     Libs/LibDBIcon-1.0:
#         url: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
#     Libs/LibDataBroker-1.1:
#         url: https://github.com/tekkub/libdatabroker-1-1
