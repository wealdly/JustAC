# Build artifacts
dist/

# Python bytecode caches (from tools/*.py generators)
__pycache__/
*.pyc

# Development files
.luarc.json
memory/
.vscode/
*.code-workspace

# luacheck binary: dev-only static-analysis tool, not committed (platform-specific,
# ~700KB). Fetch via tools/check.ps1's hint. The .luacheckrc config IS committed.
tools/luacheck.exe


# Stray tool/temp output
gh_tmp.json
*.tmp.json

# Playwright MCP browser snapshots/screenshots (local dev only)
.playwright-mcp/

# Office lock/temp files (Word leaves ~$ files while a doc is open)
~$*

# CurseForge description is maintained as Markdown (CurseForge_JustAC.md);
# the .docx is a local working copy, not version-controlled
*.docx

# Raw DB2 exports (regenerated per patch from wago.tools; only the generated
# Lua output is committed, not these multi-MB source CSVs)
Documentation/wow_spell_csv/
Documentation/wow_spell_csv_forever/

# Duplicate nested Ace3 lib folders (packaging artifact)
Libs/AceAddon-3.0/AceAddon-3.0/
Libs/AceConsole-3.0/AceConsole-3.0/
Libs/AceDB-3.0/AceDB-3.0/
Libs/AceDBOptions-3.0/AceDBOptions-3.0/
Libs/AceEvent-3.0/AceEvent-3.0/
Libs/AceTimer-3.0/AceTimer-3.0/
Libs/CallbackHandler-1.0/CallbackHandler-1.0/
Libs/LibStub/LibStub/
