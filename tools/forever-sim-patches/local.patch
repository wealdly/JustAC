index 69e8418..626be39 100644
--- a/sim/warlock/pet.go
+++ b/sim/warlock/pet.go
@@ -35,6 +35,75 @@ type PetConfig struct {
 	AutoAttacks   core.AutoAttackOptions
 }
 
+// demonBodyAtLevel is a demon's own stats and weapon at any owner level. The simulator only has
+// rows at levels 25, 40, 50 and 60 (bracket returns one of them).
+// ASSUMPTION (levelling analysis, not measured in game): between two rows every value is
+// interpolated linearly by level; below 25 the level-25 row is scaled by level/25. The crit
+// constants are the same in every row and are kept as they are. A bracket level returns its own
+// row unchanged. Owner-stat inheritance (makeStatInheritance) is separate and applies on top.
+//
+// 2026-11-23: the attributes, mana and health no longer use that interpolation. The simulator's
+// rows at 25, 40, 50 and 60 are rows of the Classic server table (core.ClassicPetLevelStats,
+// vmangos pet_levelstats; entry is the demon's creature id), so each of those stats is the
+// nearest row at or below the level (the level-25 row below 25) times the table's ratio for the
+// level. Weapon damage, which the table does not hold, keeps the interpolation.
+func demonBodyAtLevel(entry int32, level int32, bracket func(level int32) PetConfig) (stats.Stats, core.AutoAttackOptions) {
+	brackets := []int32{25, 40, 50, 60}
+	lowLevel, highLevel := int32(0), brackets[0]
+	for i, b := range brackets {
+		if level >= b {
+			lowLevel = b
+			highLevel = b
+			if i+1 < len(brackets) {
+				highLevel = brackets[i+1]
+			}
+		}
+	}
+	high := bracket(highLevel)
+	if lowLevel == highLevel {
+		return high.Stats, high.AutoAttacks
+	}
+	low := PetConfig{}
+	if lowLevel > 0 {
+		low = bracket(lowLevel)
+		if level == lowLevel {
+			return low.Stats, low.AutoAttacks
+		}
+	}
+	t := float64(level-lowLevel) / float64(highLevel-lowLevel)
+	lerp := func(a float64, b float64) float64 { return a + (b-a)*t }
+
+	body := high.Stats
+	for stat := range body {
+		if stats.Stat(stat) == stats.MeleeCrit || stats.Stat(stat) == stats.SpellCrit {
+			continue
+		}
+		body[stat] = lerp(low.Stats[stat], high.Stats[stat])
+	}
+	anchorLevel := lowLevel
+	if anchorLevel == 0 {
+		anchorLevel = brackets[0]
+	}
+	anchor := bracket(anchorLevel).Stats
+	for stat, pick := range map[stats.Stat]func(core.PetLevelStat) float64{
+		stats.Strength:  func(s core.PetLevelStat) float64 { return s.Strength },
+		stats.Agility:   func(s core.PetLevelStat) float64 { return s.Agility },
+		stats.Stamina:   func(s core.PetLevelStat) float64 { return s.Stamina },
+		stats.Intellect: func(s core.PetLevelStat) float64 { return s.Intellect },
+		stats.Spirit:    func(s core.PetLevelStat) float64 { return s.Spirit },
+		stats.Mana:      func(s core.PetLevelStat) float64 { return s.Mana },
+		stats.Health:    func(s core.PetLevelStat) float64 { return s.Health },
+	} {
+		if anchor[stat] != 0 {
+			body[stat] = anchor[stat] * core.PetLevelRatio(entry, level, anchorLevel, pick)
+		}
+	}
+	attacks := high.AutoAttacks
+	attacks.MainHand.BaseDamageMin = lerp(low.AutoAttacks.MainHand.BaseDamageMin, high.AutoAttacks.MainHand.BaseDamageMin)
+	attacks.MainHand.BaseDamageMax = lerp(low.AutoAttacks.MainHand.BaseDamageMax, high.AutoAttacks.MainHand.BaseDamageMax)
+	return body, attacks
+}
