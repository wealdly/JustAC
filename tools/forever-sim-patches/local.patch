+import (
+	"time"
+
+	"github.com/wowsims/classic/sim/core"
+)
+
+// Power Word: Shield.
+//
+// LOCAL ADDITION for levelling analysis (2026-11-23); the upstream version was commented out (a
+// level 80 spell, id 48066). A levelling priest shields before most pulls, and an absorbed hit
+// deals no damage, so it pushes no cast back (applySpellPushback skips a hit whose damage is
+// zero): without the shield every simulated priest took pushback on every hit.
+//
+// From the client spell tables (level_ranks_generated.go): the rank the level has, its absorb
+// (base points plus per-level growth up to the rank's cap, plus 0.1 of healing power), mana
+// cost and 30 s duration. Weakened Soul (6788) lasts 15 s and blocks a second shield. Improved
+// Power Word: Shield adds 5% a point, as in Classic (ASSUMED unchanged in Forever).
+func (priest *Priest) registerPowerWordShieldSpell() {
+	rank := rankFor("power_word_shield", priest.Level)
+	if rank == nil {
+		return
+	}
+	effect := rank.Effects[0]
+	grown := min(priest.Level, max(rank.MaxLevel, rank.Level))
+	absorb := effect.BasePoints + effect.PerLevel*float64(max(0, grown-rank.Level))
+
+	priest.WeakenedSouls = priest.NewRaidAuraArray(func(target *core.Unit) *core.Aura {
+		return target.GetOrRegisterAura(core.Aura{
+			Label:    "Weakened Soul",
+			ActionID: core.ActionID{SpellID: 6788},
+			Duration: time.Second * 15,
+		})
+	})
+
+	spell := priest.RegisterSpell(core.SpellConfig{
+		ActionID:    core.ActionID{SpellID: rank.SpellID},
+		SpellSchool: core.SpellSchoolHoly,
+		ProcMask:    core.ProcMaskSpellHealing,
+		Flags:       SpellFlagPriest | core.SpellFlagHelpful | core.SpellFlagAPL,
+
+		ManaCost: core.ManaCostOptions{FlatCost: rank.Cost},
+		Cast: core.CastConfig{
+			DefaultCast: core.Cast{GCD: core.GCDDefault},
+		},
+		ExtraCastCondition: func(_ *core.Simulation, target *core.Unit) bool {
+			return !priest.WeakenedSouls.Get(target).IsActive()
+		},
+
+		DamageMultiplier: 1 + .05*float64(priest.Talents.ImprovedPowerWordShield),
+		ThreatMultiplier: 1,
+
+		Shield: core.ShieldConfig{
+			Aura: core.Aura{
+				Label:    "Power Word Shield",
+				Duration: time.Duration(rank.DurationMs) * time.Millisecond,
+			},
+		},
+
+		ApplyEffects: func(sim *core.Simulation, target *core.Unit, spell *core.Spell) {
+			spell.Shield(target).Apply(sim, absorb+effect.Coefficient*spell.HealingPower(target))
+			priest.WeakenedSouls.Get(target).Activate(sim)
+		},
+	})
+	priest.PowerWordShield = []*core.Spell{spell}
+}
