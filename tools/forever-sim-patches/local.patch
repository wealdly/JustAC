+package warlock
+
+import "github.com/wowsims/classic/sim/core"
+
+// LOCAL ADDITION for levelling analysis; not upstream. Helper over level_ranks_generated.go.
+
+// rankNumber is the 1-based number of a rank within its ability, or 0 when it is not one of them.
+func rankNumber(slug string, rank *core.SpellRank) int {
+	if rank == nil {
+		return 0
+	}
+	for i := range levelRanks[slug] {
+		if levelRanks[slug][i].SpellID == rank.SpellID {
+			return i + 1
+		}
+	}
+	return 0
+}
