+		{SpellID: 25010, Level: 36, Cost: 50, Effects: [3]core.RankEffect{{Effect: 2, BasePoints: 50, Variance: 0.14545454085}}},
+		{SpellID: 25011, Level: 48, Cost: 50, Effects: [3]core.RankEffect{{Effect: 2, BasePoints: 76, Variance: 0.14285714924}}},
+		{SpellID: 25012, Level: 60, Cost: 50, Effects: [3]core.RankEffect{{Effect: 2, BasePoints: 92, Variance: 0.13207547367}}},
+	},
+	"scorpid_poison": {
+		{SpellID: 24640, Level: 8, Cost: 30, Effects: [3]core.RankEffect{{Effect: 63, BasePoints: 5}, {Effect: 6, Aura: 3, BasePoints: 1, PeriodMs: 2000}}},
+		{SpellID: 24583, Level: 24, Cost: 30, Effects: [3]core.RankEffect{{Effect: 63, BasePoints: 5}, {Effect: 6, Aura: 3, BasePoints: 2, PeriodMs: 2000}}},
+		{SpellID: 24586, Level: 40, Cost: 30, Effects: [3]core.RankEffect{{Effect: 63, BasePoints: 5}, {Effect: 6, Aura: 3, BasePoints: 4, PeriodMs: 2000}}},
+		{SpellID: 24587, Level: 56, Cost: 30, Effects: [3]core.RankEffect{{Effect: 63, BasePoints: 5}, {Effect: 6, Aura: 3, BasePoints: 5, PeriodMs: 2000}}},
+	},
+}
+
+// petRankFor is the rank of a pet ability a pet of this level can have, or nil before its first.
+func petRankFor(slug string, petLevel int32) *core.SpellRank {
+	return core.RankAtLevel(petAbilityRanks[slug], petLevel)
+}
+
+// petRankRoll is the low and high roll of a pet ability's hit: the client stores the mean and the
+// spread, and the tooltip rounds both ends (rank 8 Bite: 90 and 0.2, so 81 to 99).
+func petRankRoll(rank *core.SpellRank) (float64, float64) {
+	effect := rank.Effects[0]
+	return math.Round(effect.BasePoints * (1 - effect.Variance/2)), math.Round(effect.BasePoints * (1 + effect.Variance/2))
+}
diff --git a/sim/paladin/hammer_of_the_righteous.go b/sim/paladin/hammer_of_the_righteous.go
new file mode 100644
index 0000000..3ba9071
--- /dev/null
+++ b/sim/paladin/hammer_of_the_righteous.go
@@ -0,0 +1,65 @@
+package paladin
+
+import (
+	"time"
+
+	"github.com/wowsims/classic/sim/core"
+)
+
+// Hammer of the Righteous is a Forever paladin ability from level 40 (client 1.60.1.71037,
+// spell 407632, taught by the class's skill line). It strikes the target and up to three more
+// nearby enemies (effect 1 chain targets 4) for Holy damage equal to three times (effect 3) the
+// main-hand weapon's damage per second, costs 6% of base mana and has a 6 second category
+// cooldown. The tooltip names a cooldown shared with Crusader Strike, which Forever has no
+// ability for, so it has a timer of its own here. Melee hit table, as Holy Strike.
+// ASSUMED (local change): weapon damage per second includes attack power the way the white
+// swing does, and threat is the damage's (effect 2's 120 is not read).
+func (paladin *Paladin) registerHammerOfTheRighteous() {
+	if !paladin.Env.IsForever() || paladin.Level < 40 {
+		return
+	}
+	const weaponMultiplier = 3.0
+	numTargets := min(4, int(paladin.Env.GetNumTargets()))
+	results := make([]*core.SpellResult, numTargets)
+
+	paladin.RegisterSpell(core.SpellConfig{
+		ActionID:    core.ActionID{SpellID: 407632},
+		SpellSchool: core.SpellSchoolHoly,
+		DefenseType: core.DefenseTypeMelee,
+		ProcMask:    core.ProcMaskMeleeMHSpecial,
+		Flags:       core.SpellFlagMeleeMetrics | core.SpellFlagAPL,
+
+		RequiredLevel: 40,
+
+		ManaCost: core.ManaCostOptions{
+			BaseCost:   0.06,
+			Multiplier: paladin.benediction(),
+		},
+		Cast: core.CastConfig{
+			DefaultCast: core.Cast{
+				GCD: core.GCDDefault,
+			},
+			IgnoreHaste: true,
+			CD: core.Cooldown{
+				Timer:    paladin.NewTimer(),
+				Duration: time.Second * 6,
+			},
+		},
+
+		DamageMultiplier: paladin.spellWeaponSpecializationModifier(),
+		ThreatMultiplier: 1,
+
+		ApplyEffects: func(sim *core.Simulation, target *core.Unit, spell *core.Spell) {
+			weapon := paladin.AutoAttacks.MH()
+			baseDamage := weapon.CalculateAverageWeaponDamage(spell.MeleeAttackPower(target)) /
+				weapon.SwingSpeed * weaponMultiplier
+			for idx := range results {
+				results[idx] = spell.CalcDamage(sim, target, baseDamage, spell.OutcomeMeleeSpecialHitAndCrit)
+				target = sim.Environment.NextTargetUnit(target)
+			}
+			for _, result := range results {
+				spell.DealDamage(sim, result)
+			}
+		},
+	})
+}
diff --git a/sim/rogue/level_rank.go b/sim/rogue/level_rank.go
new file mode 100644
index 0000000..bf5a9b6
--- /dev/null
+++ b/sim/rogue/level_rank.go
@@ -0,0 +1,59 @@
+package rogue
+
+import (
+	"math"
+
+	"github.com/wowsims/classic/sim/core"
+)
+
+// LOCAL ADDITION for levelling analysis: abilities take the rank the character's level has
+// learned (level_ranks_generated.go) instead of a table keyed on levels 25, 40, 50 and 60.
+
+// Ranks taught by Ahn'Qiraj books, learnable at 60 only when core.IncludeAQ is set.
+var aqBookRanks = map[int32]bool{
+	31016: true, // Eviscerate rank 9
+	25300: true, // Backstab rank 9
+}
+
+// learnedRank is the highest rank of an ability the rogue's level has learned, or nil before
+// the first rank.
+func (rogue *Rogue) learnedRank(slug string) *core.SpellRank {
+	if core.IncludeAQ {
+		return rankFor(slug, rogue.Level)
+	}
+	var best *core.SpellRank
+	ranks := levelRanks[slug]
+	for i := range ranks {
+		if aqBookRanks[ranks[i].SpellID] || ranks[i].Level > rogue.Level {
+			continue
+		}
+		if best == nil || ranks[i].Level >= best.Level {
+			best = &ranks[i]
+		}
+	}
+	return best
+}
+
+// rollRange turns a client effect (mean base points and a spread given as a fraction of
+// them) into the low end and width of the roll.
+func rollRange(effect core.RankEffect) (float64, float64) {
+	width := math.Round(effect.BasePoints * effect.Variance)
+	return effect.BasePoints - width/2, width
+}
+
+// poisonBracket is the level whose poison values apply. The proc spells of the poisons are
+// not in the rank data, so they stay on the four bracket rows: a level uses the highest row
+// at or below it, and levels 20 to 24 use the level 25 row. Poisons are learned at 20.
+func (rogue *Rogue) poisonBracket() int32 {
+	switch {
+	case rogue.Level >= 60:
+		return 60
+	case rogue.Level >= 50:
+		return 50
+	case rogue.Level >= 40:
+		return 40
+	case rogue.Level >= 20:
+		return 25
+	}
+	return 0
+}
diff --git a/sim/shaman/level_ranks.go b/sim/shaman/level_ranks.go
new file mode 100644
index 0000000..a5327fe
--- /dev/null
+++ b/sim/shaman/level_ranks.go
@@ -0,0 +1,18 @@
+package shaman
+
+// LOCAL ADDITION for levelling analysis; not upstream. Helper over level_ranks_generated.go.
+
+// clientDamage is the current client's damage range and spell power coefficient of the rank with
+// this spell id (its first effect), for a caster of this level; ok is false when the generated
+// table does not have it. The hand-written tables came from earlier clients: by client 71037
+// Chain Lightning rank 1 was 215 (85 to 97 here, 2026-11-24) and Lightning Bolt rank 3 was 52.
+func clientDamage(slug string, spellID int32, level int32) (low, high, coefficient float64, ok bool) {
+	for i := range levelRanks[slug] {
+		rank := &levelRanks[slug][i]
+		if rank.SpellID == spellID && rank.Effects[0].Effect == 2 {
+			low, high = rank.DamageRange(0, level)
+			return low, high, rank.Effects[0].Coefficient, true
+		}
+	}
+	return 0, 0, 0, false
+}
