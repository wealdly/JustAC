diff --git a/sim/core/crit_levels_local.go b/sim/core/crit_levels_local.go
new file mode 100644
index 0000000..94bffe1
--- /dev/null
+++ b/sim/core/crit_levels_local.go
@@ -0,0 +1,16 @@
+package core
+
+import "github.com/wowsims/classic/sim/core/proto"
+
+// LOCAL ADDITION (2026-11-23), beside CritPerAgiForLevel in base_stats.go.
+//
+// CritPerIntForLevel is spell crit (percent) per Intellect at a level, from the client's
+// PlayerExpectedStat (spellCritPerIntByLevel). Every class read the level-cap constant
+// CritPerIntAtLevel at every level, which understates a low-level caster's crit from
+// intellect several times over (priest: 0.1273 per point at level 10 against the cap's value).
+func CritPerIntForLevel(c proto.Class, level int32) float64 {
+	if table, ok := spellCritPerIntByLevel[c]; ok && level >= 1 && level < CharacterMaxLevel && table[level] > 0 {
+		return table[level]
+	}
+	return CritPerIntAtLevel[c]
+}
diff --git a/sim/core/pull_model_local.go b/sim/core/pull_model_local.go
new file mode 100644
index 0000000..86f9538
--- /dev/null
+++ b/sim/core/pull_model_local.go
@@ -0,0 +1,85 @@
+package core
+
+import (
+	"os"
+	"time"
+)
+
+// Pull model for a solo fight sized by health.
+//
+// LOCAL ADDITION for levelling analysis (2026-11-23); not upstream. Off unless the environment
+// variable WOWSIM_PULL_MODEL is "1", so every other use of the simulator is unchanged.
+//
+// A simulated fight started at time zero with the target already swinging at the player. A real
+// solo pull starts when the player's first attack lands: a caster's opening cast is finished
+// before the fight begins, and the target then has to reach the caster before it can swing. Kills
+// recorded in game (JustAC's mob profile, a priest at levels 9 to 14) were a median 0.78 of the
+// simulated time, about 0.7 at levels 13 and 14, and the opening cast was most of the gap.
+//
+// With the model on:
+//   - the target does not swing until the player (or a pet) first lands anything on it;
+//   - it then needs distance / PullApproachYardsPerSecond seconds to arrive before its first
+//     swing (nothing for a player in melee range);
+//   - a pet sent from range needs the same time to reach the target before it does anything;
+//   - the fight's reported length runs from that first landing to the kill, as a kill timed in
+//     game does.
+//
+// ASSUMED: the approach speed (a creature's ordinary run speed), and that the target is pulled
+// from the player's standing distance.
+var pullModelOn = os.Getenv("WOWSIM_PULL_MODEL") == "1"
+
+const PullApproachYardsPerSecond = 7.0
+
+// pullHoldsTarget: does the target wait for the pull before it attacks?
+func (sim *Simulation) pullHoldsTarget(unit *Unit) bool {
+	return pullModelOn && unit.Type == EnemyUnit && sim.Encounter.EndFightAtHealth > 0 && !sim.Encounter.pullEngaged
+}
+
+// pullPetTravel is how long a pet needs to reach the target after it is sent at the pull: its
+// owner's distance at the approach speed, nothing for an owner in melee range. Until then it
+// neither swings nor uses an ability. Six level 15 hunter fights logged in game (2026-11-23, a
+// boar, target one level below) had the simulator's damage split (hunter 251 a fight against
+// 237 to 258, pet 105 against 105 to 126) but ran 11 to 15 s against the simulator's 10 to 11:
+// the pet dealt its damage in about 4 s less than the fight lasted.
+func (sim *Simulation) pullPetTravel(owner *Character) time.Duration {
+	if !pullModelOn || owner == nil || sim.Encounter.EndFightAtHealth <= 0 {
+		return 0
+	}
+	distance := owner.StartDistanceFromTarget
+	if distance <= MaxMeleeAttackDistance {
+		return 0
+	}
+	return time.Duration(distance / PullApproachYardsPerSecond * float64(time.Second))
+}
+
+// pullLanded is called when a spell's effects are applied: the first one a player or pet lands
+// on an enemy once the fight has started is the pull.
+func (sim *Simulation) pullLanded(spell *Spell, target *Unit) {
+	enc := &sim.Encounter
+	if !pullModelOn || enc.pullEngaged || enc.EndFightAtHealth <= 0 || sim.CurrentTime < 0 ||
+		target == nil || target.Type != EnemyUnit || spell.Unit.Type == EnemyUnit || spell.Flags.Matches(SpellFlagHelpful) {
+		return
+	}
+	enc.pullEngaged = true
+	enc.PullEngagedAt = sim.CurrentTime
+	arrive := sim.CurrentTime
+	if owner := spell.Unit; owner.Type == PlayerUnit && owner.DistanceFromTarget > MaxMeleeAttackDistance {
+		arrive += time.Duration(owner.DistanceFromTarget / PullApproachYardsPerSecond * float64(time.Second))
+	}
+	for _, enemy := range enc.TargetUnits {
+		enemy := enemy
+		StartDelayedAction(sim, DelayedActionOptions{
+			DoAt:     arrive,
+			OnAction: func(sim *Simulation) { enemy.AutoAttacks.startPull(sim) },
+		})
+	}
+}
+
+// pullFightLength is the fight's length for a health-sized fight: from the pull to the kill with
+// the model on, the whole iteration otherwise.
+func (sim *Simulation) pullFightLength() time.Duration {
+	if pullModelOn && sim.Encounter.pullEngaged {
+		return sim.CurrentTime - sim.Encounter.PullEngagedAt
+	}
+	return sim.CurrentTime
+}
diff --git a/sim/core/spell_rank.go b/sim/core/spell_rank.go
new file mode 100644
index 0000000..c726ef5
--- /dev/null
+++ b/sim/core/spell_rank.go
@@ -0,0 +1,81 @@
+package core
+
+// Per-level spell ranks.
+//
+// LOCAL ADDITION for levelling analysis (2026-11-23); not upstream. Several classes defined
+// their abilities only at levels 25, 40, 50 and 60, so a character of any other level had
+// nothing to press. Each class now carries every rank of every learnable ability from the
+// client spell tables (sim/<class>/level_ranks_generated.go, written by JustAC's
+// tools/forever-sim-patches/gen_class_ranks.py), and picks the rank its level has.
+
+// RankEffect is one effect of a rank, as the client stores it.
+type RankEffect struct {
+	Effect      int32   // SpellEffect.Effect (2 school damage, 6 apply aura, ...)
+	Aura        int32   // SpellEffect.EffectAura (3 periodic damage, ...)
+	BasePoints  float64 // the effect's value (the tooltip's low end)
+	PerLevel    float64 // points gained per caster level above the rank's level
+	PerResource float64 // points per combo point
+	Coefficient float64 // spell power coefficient
+	Variance    float64 // spread of the roll, as a fraction of the base points
+	PeriodMs    int32   // aura period
+}
+
+// SpellRank is one rank of an ability.
+type SpellRank struct {
+	SpellID    int32
+	Level      int32 // level the rank is learned at
+	MaxLevel   int32 // level its per-level growth stops at (0: none recorded)
+	Cost       float64
+	CostPct    float64
+	PowerType  int32
+	CastMs     int32
+	DurationMs int32
+	CooldownMs int32
+	Effects    [3]RankEffect
+}
+
+// RankAtLevel returns the highest rank learned at or below level (ranks in learn order), or
+// nil when the character has none yet.
+func RankAtLevel(ranks []SpellRank, level int32) *SpellRank {
+	var best *SpellRank
+	for i := range ranks {
+		if ranks[i].Level <= level && (best == nil || ranks[i].Level >= best.Level) {
+			best = &ranks[i]
+		}
+	}
+	return best
+}
+
+// Points is the base points of effect i, or 0 for a nil rank.
+func (rank *SpellRank) Points(i int) float64 {
+	if rank == nil {
+		return 0
+	}
+	return rank.Effects[i].BasePoints
+}
+
+// DamageRange is the low and high roll of effect i for a caster of this level: the client's mean
+// (base points plus per-level growth, which stops at MaxLevel) spread by its variance.
+func (rank *SpellRank) DamageRange(i int, level int32) (float64, float64) {
+	if rank == nil {
+		return 0, 0
+	}
+	effect := rank.Effects[i]
+	grown := level
+	if rank.MaxLevel > 0 && grown > rank.MaxLevel {
+		grown = rank.MaxLevel
+	}
+	mean := effect.BasePoints
+	if grown > rank.Level {
+		mean += effect.PerLevel * float64(grown-rank.Level)
+	}
+	return mean * (1 - effect.Variance/2), mean * (1 + effect.Variance/2)
+}
+
+// ID is the rank's spell id, or 0 for a nil rank.
+func (rank *SpellRank) ID() int32 {
+	if rank == nil {
+		return 0
+	}
+	return rank.SpellID
+}
diff --git a/sim/core/wand.go b/sim/core/wand.go
new file mode 100644
index 0000000..d5c44ca
--- /dev/null
+++ b/sim/core/wand.go
@@ -0,0 +1,110 @@
+package core
+
+import (
+	"time"
+
+	"github.com/wowsims/classic/sim/core/proto"
+)
+
+// Wand auto attack for casters.
+//
+// LOCAL ADDITION for levelling analysis (2026-11-18); not upstream. The engine had no wand:
+// caster classes never attacked, so a levelling caster's largest filler was missing.
+//
+// Model. With a wand equipped, the character shoots it whenever it is neither casting nor
+// inside a global cooldown, once per the wand's speed. A cast or a global cooldown stops the
+// shooting; it resumes WandRestartDelay after the character is free again.
+//
+// ASSUMPTIONS, none of them measured on WoW Forever:
+//   - Damage is the wand's own roll. No attack power, no spell power.
+//   - The shot uses the ranged hit and crit table and cannot be blocked.
+//   - The shot's school is Arcane for every wand: the item data used here carries no school,
+//     and Arcane keeps class school talents (Shadow Mastery) from applying to it. Resistance
+//     is taken against that school.
+//   - Wand Specialization adds 13% wand damage per rank, 2 ranks (Character.WandDamageBonus):
+//     the client's talent spell 6057 (mage) reads 13 and the levelling guides say 13% a rank for
+//     the priest too, whose spell 14524 reads 25.
+//   - The restart delay is 0.5s (a Blizzard post of 2026-09-23 says Auto Shot and wands are
+//     meant to have a 0.5s delay; it does not say how it applies after a cast).
+
+// From the 1.60.1.70938 client data for Shoot (5019): range 0 to 30 yards, missile speed 20.
+const WandRestartDelay = 500 * time.Millisecond
+const WandMaxRange = 30
+const WandMissileSpeed = 20
+
+// WandSpecializationBonus is the damage fraction for a Wand Specialization rank (see the
+// assumptions above).
+func WandSpecializationBonus(rank int32) float64 {
+	switch {
+	case rank <= 0:
+		return 0
+	default:
+		return 0.13 * float64(min(rank, 2))
+	}
+}
+
+// EnableWandAutoAttack gives the character a wand auto attack when a wand is equipped, and
+// reports whether it did. Call it once while the agent is constructed, and only for a class
+// that has no other auto attack: it replaces the unit's auto attack options.
+func (character *Character) EnableWandAutoAttack(agent Agent) bool {
+	item := character.GetRangedWeapon()
+	if item == nil || item.RangedWeaponType != proto.RangedWeaponType_RangedWeaponTypeWand || item.SwingSpeed <= 0 {
+		return false
+	}
+
+	weapon := newWeaponFromItem(item, 0)
+	weapon.SpellSchool = SpellSchoolArcane
+	character.EnableAutoAttacks(agent, AutoAttackOptions{
+		Ranged:          weapon,
+		AutoSwingRanged: true,
+	})
+
+	stopped := false
+	var resumeAt, gcdUntil time.Duration
+	character.RegisterResetEffect(func(_ *Simulation) {
+		stopped = false
+		resumeAt, gcdUntil = 0, 0
+	})
+
+	// The global cooldown of a real cast. The engine's own GCD timer cannot be asked: with
+	// nothing to cast, the rotation keeps pushing it forward as its way of waiting.
+	MakePermanent(character.RegisterAura(Aura{
+		Label: "Wand Stopped By Casts",
+		OnCastComplete: func(_ *Aura, sim *Simulation, spell *Spell) {
+			if spell == character.AutoAttacks.RangedAuto() || spell.CurCast.GCD <= 0 {
+				return
+			}
+			gcdUntil = max(gcdUntil, sim.CurrentTime-spell.CurCast.CastTime+spell.CurCast.GCD)
+		},
+	}))
+
+	character.AutoAttacks.rangedMinDistance = 0
+	character.AutoAttacks.rangedMaxDistance = WandMaxRange
+
+	config := character.AutoAttacks.RangedConfig()
+	config.MissileSpeed = WandMissileSpeed
+	// Caster classes get a single attack table, keyed as main hand (environment.go), so the
+	// shot is resolved against that one; there is no ranged table to use.
+	config.CastType = proto.CastType_CastTypeMainHand
+	config.ExtraCastCondition = func(sim *Simulation, _ *Unit) bool {
+		// A channel stops the wand as a cast does (2026-11-23: it was left out, so the wand
+		// resumed within 100 ms of a channel's end instead of after the restart delay).
+		if character.IsCasting(sim) || character.IsChanneling(sim) || sim.CurrentTime < gcdUntil {
+			stopped = true
+			return false
+		}
+		if stopped {
+			stopped = false
+			resumeAt = sim.CurrentTime + WandRestartDelay
+		}
+		return sim.CurrentTime >= resumeAt
+	}
+	config.ApplyEffects = func(sim *Simulation, target *Unit, spell *Spell) {
+		baseDamage := spell.Unit.AutoAttacks.Ranged().BaseDamage(sim) * (1 + character.WandDamageBonus)
+		result := spell.CalcDamage(sim, target, baseDamage, spell.OutcomeRangedHitAndCritNoBlock)
+		spell.WaitTravelTime(sim, func(sim *Simulation) {
+			spell.DealDamage(sim, result)
+		})
+	}
+	return true
+}
diff --git a/sim/druid/level_ranks.go b/sim/druid/level_ranks.go
new file mode 100644
index 0000000..8968ff3
--- /dev/null
+++ b/sim/druid/level_ranks.go
@@ -0,0 +1,41 @@
+package druid
+
+import "github.com/wowsims/classic/sim/core"
+
+// LOCAL ADDITION for levelling analysis: abilities take the rank the character's level has
+// learned (level_ranks_generated.go, from the client spell tables) instead of a table that
+// only knew levels 25, 40, 50 and 60.
+
+// Levels the forms are learned at (client SpellLevels: Bear Form 5487, Cat Form 768, Dire Bear Form 9634).
+const (
+	BearFormLevel     int32 = 10
+	CatFormLevel      int32 = 20
+	DireBearFormLevel int32 = 40
+)
+
+// learnedRank returns the rank of an ability the druid's level has learned and its 1-based
+// rank number, or nil and 0 before the first rank.
+func (druid *Druid) learnedRank(slug string) (*core.SpellRank, int) {
+	rank := rankFor(slug, druid.Level)
+	if rank == nil {
+		return nil, 0
+	}
+	number := 0
+	for _, candidate := range levelRanks[slug] {
+		if candidate.Level <= druid.Level {
+			number++
+		}
+	}
+	return rank, number
+}
+
+// learnedForm drops a starting form the level has not learned: such a druid fights in caster form.
+func learnedForm(form DruidForm, level int32) DruidForm {
+	if form.Matches(Cat) && level < CatFormLevel {
+		return Humanoid
+	}
+	if form.Matches(Bear) && level < BearFormLevel {
+		return Humanoid
+	}
+	return form
+}
