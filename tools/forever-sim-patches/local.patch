+// lowRankCurseOfElementsAura is a Forever Curse of the Elements below the top rank: every magic
+// school takes more damage and (Holy aside) loses resistance, by the rank's own numbers. It mirrors
+// core.CurseOfElementsAura, which only knows the top rank.
+func lowRankCurseOfElementsAura(target *core.Unit, spellID int32, resistance float64, damageTaken float64) *core.Aura {
+	aura := target.GetOrRegisterAura(core.Aura{
+		Label:    "Curse of Elements (rank " + strconv.Itoa(int(spellID)) + ")",
+		ActionID: core.ActionID{SpellID: spellID},
+		Duration: time.Minute * 5,
+	})
+	resistanceStats := map[stats.SchoolIndex]stats.Stat{
+		stats.SchoolIndexArcane: stats.ArcaneResistance,
+		stats.SchoolIndexFire:   stats.FireResistance,
+		stats.SchoolIndexFrost:  stats.FrostResistance,
+		stats.SchoolIndexNature: stats.NatureResistance,
+		stats.SchoolIndexShadow: stats.ShadowResistance,
+	}
+	for _, school := range []stats.SchoolIndex{stats.SchoolIndexArcane, stats.SchoolIndexFire, stats.SchoolIndexFrost, stats.SchoolIndexHoly, stats.SchoolIndexNature, stats.SchoolIndexShadow} {
+		school := school
+		aura.NewExclusiveEffect("spellDamage"+strconv.Itoa(int(school)), false, core.ExclusiveEffect{
+			Priority: damageTaken,
+			OnGain: func(ee *core.ExclusiveEffect, sim *core.Simulation) {
+				ee.Aura.Unit.PseudoStats.SchoolDamageTakenMultiplier[school] *= damageTaken
+			},
+			OnExpire: func(ee *core.ExclusiveEffect, sim *core.Simulation) {
+				ee.Aura.Unit.PseudoStats.SchoolDamageTakenMultiplier[school] /= damageTaken
+			},
+		})
+		resistanceStat, ok := resistanceStats[school]
+		if !ok {
+			continue
+		}
+		aura.NewExclusiveEffect("resistance"+strconv.Itoa(int(school)), false, core.ExclusiveEffect{
+			Priority: resistance,
+			OnGain: func(ee *core.ExclusiveEffect, sim *core.Simulation) {
+				ee.Aura.Unit.AddStatDynamic(sim, resistanceStat, -resistance)
+			},
+			OnExpire: func(ee *core.ExclusiveEffect, sim *core.Simulation) {
+				ee.Aura.Unit.AddStatDynamic(sim, resistanceStat, resistance)
+			},
+		})
+	}
+	return aura
+}
